# ── Custom Prompt (Optimized Pill Style) ──
# %{...%} wraps non-printing characters so Zsh calculates width correctly
PROMPT=$'\n%{%F{magenta}%}%{%K{magenta}%}%{%F{black}%}  %{%F{white}%} %~ %{%k%}%{%F{magenta}%}%{%f%}\n%{%F{magenta}%}❯ %{%f%}'
RPROMPT='' # Keep it clean

