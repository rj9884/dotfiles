#!/usr/bin/env bash
# Full-screen screenshot — silent capture: copies to clipboard AND saves a PNG file.
# Used by `SUPER + SHIFT + Print` (grim required).
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

grim "$FILE" 2>/dev/null || exit 0
wl-copy < "$FILE" 2>/dev/null

notify-send -t 4000 "Screenshot saved" "$FILE"
