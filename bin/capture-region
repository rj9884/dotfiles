#!/usr/bin/env bash
# Region screenshot — silent capture: copies to clipboard AND saves a PNG file.
# Used by the bare `Print` key (grim + slurp required).
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%Y-%m-%d_%H-%M-%S).png"

AREA=$(slurp 2>/dev/null) || exit 0
grim -g "$AREA" "$FILE" 2>/dev/null || exit 0
wl-copy < "$FILE" 2>/dev/null

notify-send -t 4000 "Screenshot saved" "$FILE"
