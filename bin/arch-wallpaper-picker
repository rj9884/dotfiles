#!/usr/bin/env bash
# ──────────────────────────────────────────────
#   arch-wallpaper-picker — quattro-style wallpaper picker.
#   Horizontal thumbnail carousel over the wallpaper collections; the chosen
#   image is applied through swww-all.sh (set + matugen palette + reloads).
# ──────────────────────────────────────────────

WALL_DIR="$HOME/.local/share/wallpapers"
SWWW_SCRIPT="$HOME/.config/hypr/scripts/swww-all.sh"

[ -d "$WALL_DIR" ] || { echo "Wallpaper directory not found: $WALL_DIR" >&2; exit 1; }

# arch-menu-images scans one level deep, so hand it the per-theme
# subdirectories; fall back to the flat dir if there are none.
dirs=()
for d in "$WALL_DIR"/*/; do
  [ -d "$d" ] && dirs+=("$d")
done
((${#dirs[@]})) || dirs=("$WALL_DIR")

image=$("$HOME/.local/bin/arch-menu-images" \
  --show-labels --filterable --lazy-thumbnails "${dirs[@]}")

[[ -n $image ]] && [[ -f $image ]] || exit 0

"$SWWW_SCRIPT" "$image"