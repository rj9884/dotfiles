// ──────────────────────────────────────────────
//   Waybar Configuration — Noro Theme (Exact Match)
// ──────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 15,
    "margin-right": 15,
    "modules-left": [
        "custom/launcher",
        "custom/record",
        "custom/voxtype",
        "custom/updates",
        "clock",
        "custom/user"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "backlight",
        "pulseaudio",
        "mpris",
        "custom/group"
    ],
    "modules-right": [
        "tray",
        "custom/notifications",
        "custom/clipboard",
        "custom/vpn",
        "custom/power-profile",
        "battery",
        "network",
        "bluetooth",
        "custom/power"
    ],
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "custom/record": {
        "exec": "~/.config/waybar/scripts/recorder.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/recorder.sh toggle"
    },
    "custom/voxtype": {
        "exec": "~/.config/waybar/scripts/voxtype.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "voxtype record stop"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "custom/user": {
        "exec": "whoami",
        "format": "{}",
        "interval": "once",
        "tooltip": false
    },
    // ── Workspaces ────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "󰖟",
            "2": "󰆍",
            "3": "󰉋",
            "4": "󰨞",
            "active": "󰮯",
            "default": "󰊠",
            "empty": "󰊠"
        },
        "persistent-workspaces": {
            "*": 4
        }
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "kitty --class wiremix -e wiremix",
        "tooltip": false
    },
    "battery": {
        "bat": "BAT1",
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󱐋",
        "format-plugged": "{capacity}% 󱐋",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": false,
        "interval": 30
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "tooltip": false
    },
    "bluetooth": {
        "format": "󰂯",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "tooltip": false
    },
    "custom/power-profile": {
        "exec": "~/.config/waybar/scripts/power-profile.sh",
        "return-type": "text",
        "interval": 5,
        "on-click": "~/.local/bin/power-profiles menu",
        "tooltip": false
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 1800,
        "on-click": "kitty -e bash -c 'yay -Syu; echo; read -p \"Press Enter to close...\"'",
        "tooltip": true
    },
    "custom/group": {
        "exec": "~/.config/waybar/scripts/group-indicator.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/clipboard": {
        "format": "󰅇",
        "on-click": "~/.local/bin/menu-clipboard",
        "tooltip": false
    },
    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn-status.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "tooltip": true
    },
    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "swaync-client -t -sw",
        "tooltip": true
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "󰐊",
            "chromium": "󰖟",
            "mpv": "󰐊"
        },
        "status-icons": {
            "playing": "󰏤",
            "paused": "󰐊",
            "stopped": "󰓛"
        },
        "max-length": 30,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "tooltip": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    }
}
