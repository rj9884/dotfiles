<?xml version="1.0" encoding="UTF-8"?>
<!-- Matugen Dynamic Syntax Scheme (gtksourceview-5) -->
<!-- Applied to GNOME Text Editor via ~/.local/share/gtksourceview-5/styles/Matugen.xml -->
<style-scheme id="matugen" _name="Matugen" version="1.0">
  <author>rajan</author>
  <_description>Matugen Material palette</_description>

  <!-- Colors (mirrors kitty/rofi matugen palette) -->
  <color name="bg"             value="{{colors.surface.default.hex}}"/>
  <color name="fg"             value="{{colors.on_surface.default.hex}}"/>
  <color name="dim"            value="{{colors.on_surface_variant.default.hex}}"/>
  <color name="faint"          value="{{colors.outline_variant.default.hex}}"/>
  <color name="outline"        value="{{colors.outline.default.hex}}"/>
  <color name="accent"         value="{{colors.primary.default.hex}}"/>
  <color name="accent_fg"      value="{{colors.on_primary.default.hex}}"/>
  <color name="container"      value="{{colors.primary_container.default.hex}}"/>
  <color name="on_container"   value="{{colors.on_primary_container.default.hex}}"/>
  <color name="surface_hi"     value="{{colors.surface_container.default.hex}}"/>
  <color name="secondary"      value="{{colors.secondary.default.hex}}"/>
  <color name="tertiary"       value="{{colors.tertiary.default.hex}}"/>
  <color name="error"          value="{{colors.error.default.hex}}"/>
  <color name="on_error"       value="{{colors.on_error.default.hex}}"/>

  <!-- Global Settings -->
  <style name="text"                 foreground="fg" background="bg"/>
  <style name="selection"            foreground="accent_fg" background="accent"/>
  <style name="cursor"               foreground="accent"/>
  <style name="current-line"         background="surface_hi"/>
  <style name="line-numbers"         foreground="outline" background="bg"/>
  <style name="draw-spaces"          foreground="faint"/>
  <style name="right-margin"         foreground="faint" background="faint"/>
  <style name="background-pattern"   background="surface_hi"/>

  <!-- Bracket Matching -->
  <style name="bracket-match"        foreground="on_container" background="container"/>
  <style name="bracket-mismatch"     foreground="on_error" background="error"/>

  <!-- Search Matching -->
  <style name="search-match"         foreground="on_container" background="container"/>

  <!-- Comments -->
  <style name="def:comment"          foreground="dim" italic="true"/>
  <style name="def:shebang"          foreground="dim" italic="true"/>
  <style name="def:doc-comment-element" foreground="dim" bold="true"/>

  <!-- Constants and Variables -->
  <style name="def:constant"         foreground="accent"/>
  <style name="def:string"           foreground="secondary"/>
  <style name="def:special-char"     foreground="tertiary"/>
  <style name="def:special-constant" foreground="accent" bold="true"/>
  <style name="def:number"           foreground="error"/>
  <style name="def:floating-point"   foreground="error"/>
  <style name="def:boolean"          foreground="error"/>
  <style name="def:keyword"          foreground="accent" bold="true"/>
  <style name="def:builtin"          foreground="accent" bold="true"/>
  <style name="def:variable"         foreground="fg"/>

  <!-- Identifiers -->
  <style name="def:identifier"       foreground="fg"/>
  <style name="def:function"         foreground="tertiary"/>

  <!-- Statements -->
  <style name="def:statement"        foreground="accent"/>

  <!-- Types -->
  <style name="def:type"             foreground="secondary"/>

  <!-- Markup -->
  <style name="def:emphasis"         italic="true"/>
  <style name="def:strong-emphasis"  foreground="accent"/>
  <style name="def:inline-code"      foreground="fg"/>
  <style name="def:insertion"        underline="single"/>
  <style name="def:deletion"         strikethrough="true"/>
  <style name="def:link-text"        foreground="accent" italic="true"/>
  <style name="def:link-symbol"      foreground="accent" italic="true"/>
  <style name="def:link-destination" underline="single"/>
  <style name="def:heading"          foreground="accent"/>
  <style name="def:thematic-break"   foreground="outline"/>
  <style name="def:preformatted-section" foreground="fg"/>
  <style name="def:list-marker"      foreground="accent"/>

  <!-- Others -->
  <style name="def:error"            foreground="on_error" background="error" bold="true"/>
  <style name="def:warning"          foreground="on_error" background="tertiary" bold="true"/>
  <style name="def:note"             foreground="on_container" background="container" bold="true"/>
  <style name="def:net-address"      foreground="accent" underline="single"/>
  <style name="def:preprocessor"     foreground="tertiary"/>
  <style name="def:underlined"       underline="single"/>

  <!-- Diff Styles -->
  <style name="diff:ignore"          foreground="faint"/>
  <style name="diff:added-line"      foreground="secondary"/>
  <style name="diff:removed-line"    foreground="error"/>
  <style name="diff:changed-line"    foreground="tertiary"/>
  <style name="diff:diff-file"       foreground="accent" bold="true"/>
  <style name="diff:location"        foreground="accent"/>
  <style name="diff:special-case"    foreground="error" bold="true"/>
</style-scheme>