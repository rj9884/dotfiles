{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.secondary.default.hex}}",
      "3": "{{colors.tertiary.default.hex}}",
      "4": "{{colors.on_surface.default.hex}}",
      "5": "{{colors.primary.default.hex}}",
      "6": "{{colors.tertiary.default.hex}}"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.primary.default.hex}}"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": "󰒋 Ker"
    },
    {
      "type": "uptime",
      "key": "󰅐 Upt"
    },
    {
      "type": "packages",
      "key": "󰏖 Pkg"
    },
    {
      "type": "shell",
      "key": "󰞷 Sh"
    },
    {
      "type": "wm",
      "key": "󱂬 WM"
    },
    {
      "type": "memory",
      "key": "󰍛 Mem"
    },
    {
      "type": "zram",
      "key": "󰍛 Zrm"
    },
    {
      "type": "disk",
      "key": "󰋊 Dsk"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    "break",
    "colors"
  ]
}