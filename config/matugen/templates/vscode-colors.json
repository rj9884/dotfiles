  "editor.tokenColorCustomizations": {
    "comments": "{{colors.on_surface_variant.default.hex}}",
    "strings": "{{colors.on_secondary_container.default.hex}}",
    "keywords": "{{colors.primary.default.hex}}",
    "numbers": "{{colors.on_tertiary_container.default.hex}}",
    "types": "{{colors.tertiary.default.hex}}",
    "functions": "{{colors.on_primary_container.default.hex}}",
    "variables": "{{colors.on_surface.default.hex}}",
    "textMateRules": [
      {"scope": "comment", "settings": {"fontStyle": "italic"}},
      {"scope": ["comment.line", "comment.block"], "settings": {"fontStyle": "italic"}},
      {"scope": "keyword.control", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "keyword.operator", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "storage", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "storage.type", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "string.quoted", "settings": {"foreground": "{{colors.on_secondary_container.default.hex}}"}},
      {"scope": "string.template", "settings": {"foreground": "{{colors.on_secondary_container.default.hex}}"}},
      {"scope": "string.regexp", "settings": {"foreground": "{{colors.tertiary.default.hex}}"}},
      {"scope": "constant.numeric", "settings": {"foreground": "{{colors.on_tertiary_container.default.hex}}"}},
      {"scope": "constant.language", "settings": {"foreground": "{{colors.on_tertiary_container.default.hex}}"}},
      {"scope": "constant.character", "settings": {"foreground": "{{colors.on_tertiary_container.default.hex}}"}},
      {"scope": "entity.name.function", "settings": {"foreground": "{{colors.on_primary_container.default.hex}}"}},
      {"scope": "entity.name.class", "settings": {"foreground": "{{colors.tertiary.default.hex}}"}},
      {"scope": "entity.name.type", "settings": {"foreground": "{{colors.tertiary.default.hex}}"}},
      {"scope": "entity.name.tag", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "entity.other.attribute-name", "settings": {"foreground": "{{colors.on_secondary_container.default.hex}}"}},
      {"scope": "variable", "settings": {"foreground": "{{colors.on_surface.default.hex}}"}},
      {"scope": "variable.parameter", "settings": {"foreground": "{{colors.on_surface.default.hex}}"}},
      {"scope": "variable.other.property", "settings": {"foreground": "{{colors.on_secondary_container.default.hex}}"}},
      {"scope": "punctuation", "settings": {"foreground": "{{colors.on_surface_variant.default.hex}}"}},
      {"scope": "punctuation.definition.tag", "settings": {"foreground": "{{colors.on_surface_variant.default.hex}}"}},
      {"scope": "meta.tag", "settings": {"foreground": "{{colors.primary.default.hex}}"}},
      {"scope": "markup.heading", "settings": {"foreground": "{{colors.primary.default.hex}}", "fontStyle": "bold"}},
      {"scope": "markup.bold", "settings": {"fontStyle": "bold"}},
      {"scope": "markup.italic", "settings": {"fontStyle": "italic"}},
      {"scope": "markup.inline.raw", "settings": {"foreground": "{{colors.on_secondary_container.default.hex}}"}},
      {"scope": "markup.fenced_code", "settings": {"foreground": "{{colors.on_surface.default.hex}}"}}
    ]
  },
