/* ── Material You Picker (centered) ── */
@import "~/.config/rofi/colors.rasi"

* {
    bg:       @background;
    bg-alt:   @background-alt;
    fg:       @foreground;
    accent:   @selected;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            700px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    12px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg;
    border-radius:    12px;
    children:         [ inputbar, message, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px 12px 0 0;
    padding:          14px 22px;
    spacing:          12px;
    children:         [ entry ];
}


entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search…";
    placeholder-color: @fg;
    vertical-align:   0.5;
}

message {
    background-color: @bg-alt;
    padding:          6px 22px;
}

textbox {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Italic 10";
}

listview {
    background-color: @bg;
    border-radius:    0 0 12px 12px;
    columns:          1;
    lines:            9;
    spacing:          4px;
    padding:          16px;
    margin:           0;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          16px 16px;
    spacing:          14px;
    border-radius:    12px;
}

element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             20px;
}

element-text {
    text-color:       @fg;
    vertical-align:   0.5;
    margin:           0 6px 0 0;
}

element-text selected.normal,
element-text selected {
    text-color:       @bg;
}
