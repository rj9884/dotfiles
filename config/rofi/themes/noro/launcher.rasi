/* ── Material You App Launcher (compact) ── */
@import "~/.config/rofi/colors.rasi"

* {
    bg:       @background;
    bg-alt:   @background-alt;
    fg:       @foreground;
    accent:   @selected;
    urgent:   @urgent;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            560px;
    background-color: @bg;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    12px;
    padding:          0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg;
    border-radius:    12px;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @bg-alt;
    border-radius:    12px 12px 0 0;
    padding:          14px 20px;
    spacing:          10px;
    children:         [ entry ];
}


entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search apps…";
    placeholder-color: @fg;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 12";
}

listview {
    background-color: @bg;
    border-radius:    0 0 12px 12px;
    columns:          1;
    lines:            12;
    spacing:          2px;
    padding:          8px;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          11px 16px;
    spacing:          12px;
    border-radius:    12px;
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             22px;
}

element-text {
    text-color:       @fg;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 11";
}

element-text selected.normal,
element-text selected {
    text-color:       @bg;
}