/* ── Glass App Launcher (compact) ── */
@import "~/.config/rofi/colors.rasi"

* {
    bg:       @background;
    bg-alt:   @background-alt;
    fg:       @foreground;
    accent:   @selected;
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            560px;
    background-color: rgba(0, 0, 0, 0.45);
    border:           1px solid;
    border-color:     rgba(255, 255, 255, 0.08);
    border-radius:    12px;
    location:         center;
    anchor:           center;
}

mainbox {
    border-radius:    12px;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: rgba(255, 255, 255, 0.06);
    border-radius:    12px 12px 0 0;
    padding:          14px 22px;
    spacing:          12px;
    children:         [ entry ];
}


entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Search apps…";
    placeholder-color: rgba(255,255,255,0.25);
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 12";
}

listview {
    background-color: transparent;
    border-radius:    0 0 12px 12px;
    columns:          1;
    lines:            12;
    spacing:          3px;
    padding:          10px;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          12px 18px;
    spacing:          12px;
    border-radius:    12px;
}

element selected.normal {
    background-color: rgba(255, 255, 255, 0.12);
    text-color:       @fg;
}

element-icon {
    size:             32px;
}

element-text {
    text-color:       @fg;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 11";
}

element-text selected.normal,
element-text selected {
    text-color:       @fg;
}