/* ──────────────────────────────────────────────
 *   Rofi Image Carousel – horizontal thumbnail picker
 *   Used by the wallpaper & theme pickers.
 *   A centered, single-row carousel (arrow keys scroll it), matching the
 *   original quickshell look without the overlay chrome.
 *   Colors follow the active matugen palette.
 * ────────────────────────────────────────────── */

@import "~/.config/rofi/colors.rasi"

* {
    bg:             @background;
    bg-alt:         @background-alt;
    fg:             @foreground;
    accent:         @selected;

    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            92%;
    location:         center;
    anchor:           center;
    background-color: @bg;
    border-radius:    24px;
    border:           1px;
    border-color:     @bg-alt;
    padding:          0px;
    children:         [ mainbox ];
}

mainbox {
    background-color: transparent;
    orientation:      vertical;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          18px;
}

inputbar {
    background-color: transparent;
    children:         [ prompt, entry ];
    padding:          2px 6px 12px 6px;
    spacing:          10px;
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font 11";
}

entry {
    background-color: transparent;
    text-color:       @fg;
    placeholder:      "Filter…";
    placeholder-color: @bg-alt;
    font:             "JetBrainsMono Nerd Font 11";
}

listview {
    flow:             horizontal;
    columns:          5;
    lines:            1;
    spacing:          16px;
    padding:          4px;
    scrollbar:        false;
    dynamic:          true;
    fixed-height:     false;
    background-color: transparent;
}

element {
    orientation:      vertical;
    background-color: @bg-alt;
    border-radius:    16px;
    padding:          10px;
    spacing:          8px;
}

element-icon {
    size:             260px;
    border-radius:    12px;
}

element-text {
    text-color:       @fg;
    horizontal-align: 0.5;
    font:             "JetBrainsMono Nerd Font 10";
}

element selected.normal,
element selected {
    background-color: @accent;
    border-radius:    16px;
}

element selected.normal element-text,
element selected element-text {
    text-color:       @bg;
}
