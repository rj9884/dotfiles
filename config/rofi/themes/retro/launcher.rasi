/* ── Retro App Launcher (compact) ── */
@import "~/.config/rofi/colors.rasi"

* {
    bg:       @background;
    bg-alt:   @background-alt;
    fg:       @foreground;
    accent:   @selected;
    background-color: transparent;
    text-color:       @fg;
}

window {
    width:            560px;
    background-color: @bg;
    border:           3px solid;
    border-color:     @accent;
    border-radius:    0;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @bg;
    children:         [ inputbar, listview ];
    spacing:          0;
    padding:          0;
}

inputbar {
    background-color: @accent;
    padding:          10px 16px;
    spacing:          10px;
    children:         [ entry ];
}


entry {
    background-color: transparent;
    text-color:       @bg;
    placeholder:      "Search apps>";
    placeholder-color: rgba(0,0,0,0.4);
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 12";
}

listview {
    background-color: @bg;
    columns:          1;
    lines:            12;
    spacing:          0;
    padding:          4px;
    scrollbar:        false;
    fixed-height:     false;
    dynamic:          true;
}

element {
    background-color: transparent;
    text-color:       @fg;
    padding:          10px 14px;
    spacing:          10px;
    border-radius:    0;
    border-bottom:    1px solid;
    border-color:     rgba(255,255,255,0.04);
}

element selected.normal {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             32px;
}

element-text {
    text-color:       @fg;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font 11";
}

element-text selected.normal,
element-text selected {
    text-color:       @bg;
}